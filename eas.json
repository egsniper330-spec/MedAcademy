{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.eu.cc/backend/public/index.php"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.eu.cc/backend/public/index.php"
      }
    },
    "release-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.eu.cc/backend/public/index.php"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.eu.cc/backend/public/index.php"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.eu.cc/backend/public/index.php"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
