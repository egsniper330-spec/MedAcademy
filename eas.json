{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.site/backend/public/index.php"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.site/backend/public/index.php"
      }
    },
    "security-test": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.site/backend/public/index.php",
        "EXPO_PUBLIC_SECURITY_TEST_BUILD": "1"
      }
    },
    "release-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.site/backend/public/index.php"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.site/backend/public/index.php"
      }
    },
    "production": {
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_APP_ID": "app-czyg340mpc75",
        "EXPO_PUBLIC_PHP_API_URL": "https://api.medacademy.site/backend/public/index.php"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
