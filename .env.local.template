# ============================================================
# MedAcademy — Mobile App Environment Template
# ============================================================
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.local.template .env.local
#   2. Fill in your values in .env.local
#   3. Never commit .env.local — it is excluded by .gitignore
#
# ⚠️  SECURITY BOUNDARY — READ THIS FIRST:
#   This file contains ONLY client-safe variables.
#   Variables prefixed EXPO_PUBLIC_ are bundled INTO the app binary.
#   They are visible to anyone who decompiles the app.
#   NEVER add SERVICE_ROLE_KEY, DB_PASSWORD, or API secrets here.
#
#   Server-side secrets belong in:
#     → supabase/secrets.template   (Supabase CLI / Edge Functions)
# ============================================================

# ── Supabase (client-safe — bundled into the app) ────────────
# Supabase Dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase Dashboard → Project Settings → API → anon / public key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── App Identity ─────────────────────────────────────────────
# Stable application identifier — independent from the backend provider.
# Do NOT use the Supabase project reference here.
EXPO_PUBLIC_APP_ID=medacademy

# ── Deep Link Scheme ─────────────────────────────────────────
EXPO_PUBLIC_APP_SCHEME=medacademy
