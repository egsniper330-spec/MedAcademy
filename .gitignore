# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ── Android RELEASE SIGNING — secrets, NEVER commit ─────────────────────────
# The production keystore itself lives OUTSIDE the repo (~/.medacademy/).
# These patterns protect against anyone copying it or its credential files
# into the project tree.
gradle.properties.local
expected-cert-sha256.local
signing.properties
medacademy-release.keystore*
*release*.jks
*.local

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# ── Crash / diagnostic artifacts — NEVER commit ──────────────────────────────
# JVM crash dumps and JIT replay logs (written by the Gradle daemon on OOM).
hs_err_pid*.log
replay_pid*.log
# Console/build dumps captured while investigating a specific bug.
*-test.txt
# Preview/dev-server logs written into the repo root by tooling.
*preview-*.log
*preview-*.log.err

# Compiled state models written by scripts/run-state-tests.cjs (regenerated
# on every `npm run test:state`)
scripts/state-build/

# macOS
.DS_Store
*.pem

# local env files — never commit real credentials
# .env.local.template IS committed (safe — contains only empty placeholders)
.env
.env.local
.env.development.local
.env.staging.local
.env.production.local
.env*.local

# Supabase server-side secrets (CLI use only — never in app bundle)
supabase/.env.secrets

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code
.claude/
output/
output.tar.gz

.native-wind-cache/
.metro-cache/
package.json.*
.sync

.freebuff/

# local git-history backup (never commit)
.git-backup/

# IDE / editor state (per-developer, never commit)
.idea/
*.iml
