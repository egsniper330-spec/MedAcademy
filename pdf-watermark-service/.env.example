# Copy to .env on the VPS. Never commit real values.
# Generate secrets with: python -c "import secrets;print(secrets.token_urlsafe(48))"

# Format: keyid:secret[,keyid:secret]. Several active keys allow rotation.
PDF_SVC_HMAC_KEYS=k1:replace-with-at-least-32-random-characters-xxxxxxxx

PDF_SVC_CLOCK_SKEW_SECONDS=300
PDF_SVC_MAX_REQUEST_BYTES=1048576

# Private local paths (outside any web-served directory).
PDF_SVC_STORAGE_ROOT=/var/lib/pdf-watermark/storage
PDF_SVC_STATE_DB_PATH=/var/lib/pdf-watermark/state.sqlite3

# Queue (initial target 4-6 workers on a CPU-only VPS).
PDF_SVC_WORKER_COUNT=4
PDF_SVC_JOB_LEASE_SECONDS=900
PDF_SVC_JOB_MAX_ATTEMPTS=3
PDF_SVC_JOB_RETRY_DELAY_SECONDS=30

# Phase B: master page rendering
PDF_SVC_MASTER_RENDER_DPI=150
PDF_SVC_MASTER_MAX_PAGES=500

# Phase C: personalised issuance. WAM checkpoint is fixed by path and verified by SHA-256 at load.
PDF_SVC_WAM_REPO_DIR=./wam
PDF_SVC_WAM_CHECKPOINT=./wam/checkpoints/wam_mit.pth
PDF_SVC_WAM_PARAMS_JSON=./wam/checkpoints/params.json
# WAM model process (app.wam_runtime) is a separate loopback process; the API calls it over HMAC.
PDF_SVC_WAM_RUNTIME_URL=http://127.0.0.1:8711
PDF_SVC_WAM_HMAC_KEY=
PDF_SVC_ISSUANCE_TTL_SECONDS=86400
PDF_SVC_ISSUANCE_LEASE_SECONDS=900
# Identical-request wait before returning HTTP 202 pending (0-60 seconds).
PDF_SVC_ISSUANCE_WAIT_SECONDS=10
# Replay-protection nonce store for the WAM process (private, not web-served).
PDF_SVC_WAM_STATE_DIR=/var/lib/pdf-watermark/wam-state
# Cleanup runner pass interval (60-900 seconds).
PDF_SVC_CLEANUP_INTERVAL_SECONDS=300
