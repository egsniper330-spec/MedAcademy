# API service environment (pdf-watermark-api.service). Copy to /etc/pdf-watermark/api.env (mode 0640, owner root:pdfwm).
# Never commit real values. Generate secrets with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Placeholders below MUST be replaced on the VPS. The API refuses to start if the HMAC keys are missing.

# Server-to-server HMAC keys, "keyid:secret[,keyid:secret]". Several active keys allow rotation (see OPERATIONS.md).
PDF_SVC_HMAC_KEYS=CHANGE-ME-keyid:CHANGE-ME-at-least-32-random-characters
PDF_SVC_CLOCK_SKEW_SECONDS=300
PDF_SVC_MAX_REQUEST_BYTES=1048576

# Private paths. Must be outside any web-served directory and owned by the pdfwm user.
PDF_SVC_STORAGE_ROOT=/var/lib/pdf-watermark/storage
PDF_SVC_STATE_DB_PATH=/var/lib/pdf-watermark/state.sqlite3

# Bind to loopback only. The PHP server reaches it through a local reverse proxy or the same host.
PDF_SVC_BIND_HOST=127.0.0.1
PDF_SVC_BIND_PORT=8787

# Queue workers (4-6 is the initial target on a CPU-only VPS).
PDF_SVC_WORKER_COUNT=4
PDF_SVC_JOB_LEASE_SECONDS=900
PDF_SVC_JOB_MAX_ATTEMPTS=3
PDF_SVC_JOB_RETRY_DELAY_SECONDS=30

# Master page rendering limits.
PDF_SVC_MASTER_RENDER_DPI=150
PDF_SVC_MASTER_MAX_PAGES=500

# Personalised issuance. The API never loads the model; it calls the WAM runtime over loopback HMAC.
PDF_SVC_WAM_RUNTIME_URL=http://127.0.0.1:8711
# Must equal the key in wam.env (the same keyid:secret pair as the WAM runtime expects).
PDF_SVC_WAM_HMAC_KEY=CHANGE-ME-keyid:CHANGE-ME-same-as-wam-env
PDF_SVC_ISSUANCE_TTL_SECONDS=86400
PDF_SVC_ISSUANCE_LEASE_SECONDS=900
PDF_SVC_ISSUANCE_WAIT_SECONDS=10

# Cleanup runner pass interval (60-900 seconds). Used by pdf-watermark-cleanup.service.
PDF_SVC_CLEANUP_INTERVAL_SECONDS=300
