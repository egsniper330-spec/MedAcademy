# WAM runtime environment (pdf-watermark-wam.service). Copy to /etc/pdf-watermark/wam.env (mode 0640, owner root:pdfwm).
# Never commit real values. The WAM process listens on loopback only and is never exposed publicly.
# Placeholders below MUST be replaced on the VPS. The process refuses to start without the HMAC key.

# Must match the API's PDF_SVC_WAM_HMAC_KEY exactly ("keyid:secret").
PDF_SVC_WAM_HMAC_KEY=CHANGE-ME-keyid:CHANGE-ME-same-as-api-env

PDF_SVC_WAM_HOST=127.0.0.1
PDF_SVC_WAM_PORT=8711

# Upstream repo tree and the approved checkpoint. Paths are operator-set; requests never supply a path.
# The checkpoint's SHA-256 is verified against the pinned value before load (wam_adapter.verify_checkpoint).
PDF_SVC_WAM_REPO_DIR=/opt/pdf-watermark-service/wam
PDF_SVC_WAM_CHECKPOINT=/opt/pdf-watermark-service/wam/checkpoints/wam_mit.pth
PDF_SVC_WAM_PARAMS_JSON=/opt/pdf-watermark-service/wam/checkpoints/params.json

# Private nonce store for replay protection (not web-served).
PDF_SVC_WAM_STATE_DIR=/var/lib/pdf-watermark/wam-state

# Keep CPU threading bounded so the WAM process does not starve the API and PHP on a small VPS.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
