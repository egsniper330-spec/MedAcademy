# =============================================================================
# MedAcademy PHP API — environment template
# Copy to backend/.env on the server and fill in real values.
# NEVER commit .env and never put real values in this template.
# =============================================================================

# --- Environment ------------------------------------------------------------
APP_ENV=production            # production | staging | local
APP_DEBUG=false
APP_URL=https://api.medacademy.eu.cc
APP_NAME=MedAcademy

# --- Database (created in cPanel: MySQL database + user) --------------------
# NOTE: the variable is DB_PASS (not DB_PASSWORD) in this backend.
DB_HOST=localhost              # cPanel: localhost (or 127.0.0.1)
DB_PORT=3306
DB_NAME=CHANGE_ME_DB_NAME
DB_USER=CHANGE_ME_DB_USER
DB_PASS=CHANGE_ME_DB_PASSWORD

# --- JWT --------------------------------------------------------------------
# Generate with:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ISSUER=https://api.medacademy.eu.cc
JWT_AUDIENCE=medacademy-app
JWT_ACCESS_TTL_SECONDS=900        # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000   # 30 days

# --- CORS -------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. The native app
# sends no Origin header and is always allowed.
CORS_ALLOWED_ORIGINS=https://medacademy.eu.cc,http://localhost:8081

# --- Email (forgot/reset password, verification) ----------------------------
# Defaults to PHP mail(); set SMTP_* to use SMTP (recommended on cPanel).
MAIL_FROM=noreply@medacademy.eu.cc
MAIL_FROM_NAME=MedAcademy
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME
# SMTP_SECURE=ssl              # ssl (465) | tls (587)

# --- VdoCipher (server-side only; never ship to the app) ---------------------
VDOCIPHER_API_SECRET=CHANGE_ME_VDOCIPHER_API_SECRET
VDOCIPHER_API_BASE=https://dev.vdocipher.com/api
VDOCIPHER_FOLDER_ID=           # optional upload folder id
VDOCIPHER_WEBHOOK_SECRET=      # optional; enables the /video/webhook endpoint

# --- Storage ----------------------------------------------------------------
STORAGE_PUBLIC_DIR=storage/public
STORAGE_PRIVATE_DIR=storage/private
STORAGE_SIGNED_URL_TTL_SECONDS=3600
# HMAC secret for signed private-file URLs; keep it long and unique:
STORAGE_SIGNED_URL_SECRET=CHANGE_ME_STORAGE_SIGNED_URL_SECRET

# --- Auth behaviour ----------------------------------------------------------
# true = accounts are usable immediately after registration (current UX).
# false = email verification required before login (Phase 2 email flow).
AUTH_AUTO_CONFIRM=true
PASSWORD_RESET_TTL_SECONDS=1800   # 30 minutes

# --- Security ---------------------------------------------------------------
# Starting profiles.security_version after migration (1 unless you need to
# force-logout everyone at cutover).
SECURITY_INITIAL_VERSION=1
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10

# --- Logging -----------------------------------------------------------------
LOG_DIR=storage/logs
LOG_LEVEL=info                 # debug | info | warning | error
