+package com.reactnativecommunity.webview
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import android.os.Build
+import android.webkit.ServiceWorkerController
+import android.webkit.WebView
+import java.lang.ref.WeakReference
+
+/**
+ * MedAcademy fork: NATIVE WebView network gate.
+ *
+ * WHY THIS EXISTS
+ * ---------------
+ * A WebView starts its own network activity the instant a source is loaded, and
+ * React Native needs a JS round trip (plus a render) before it can unmount the
+ * view. A VPN that becomes active in that window is therefore detected natively
+ * but the requests it should have prevented have already left.
+ *
+ * This gate closes that window natively:
+ *
+ *   • A gated WebView is created with `WebSettings.setBlockNetworkLoads(true)`,
+ *     before any document exists.
+ *   • The FIRST document is only loaded after an AUTHORIZER installed by the
+ *     app returns an allow decision from a FRESH reading of the current VPN
+ *     state. There is no JS path that can authorize, unblock or override.
+ *   • When the app's VPN watch raises, it calls [blockAll]: on the main thread
+ *     every live gated WebView gets `blockNetworkLoads = true` and
+ *     `stopLoading()`, immediately — no React render required.
+ *
+ * HONEST LIMITATION (do not overstate this): a request that the WebView handed
+ * to the network stack BEFORE the block was applied cannot be recalled. The
+ * gate removes requests that would start AFTER it, not ones already in flight.
+ * `blockNetworkLoads` cancels the *loading* of new network resources; it does
+ * not rewind a dispatch that already happened.
+ *
+ * AUTHORIZATION IS FAIL-CLOSED: no authorizer, a throwing authorizer, a VPN, or
+ * an UNKNOWN/absent native answer all deny. Denial leaves the WebView blocked.
+ *
+ * RELOAD SEMANTICS: unblocking after content is already displayed would need a
+ * `reload()` for the displayed document's subresources. This gate therefore
+ * authorizes BEFORE the first load, so no reload is ever required; a later VPN
+ * raise blocks and the app unmounts the view.
+ */
+object RNCWebViewNetworkGate {
+
+    const val TAG = "MedAcademyWebViewGate"
+
+    /** One authorization answer. Only [allowed] grants a load. */
+    class Decision(val allowed: Boolean, val reason: String)
+
+    /**
+     * Implemented by the app's native security module. MUST read the CURRENT
+     * VPN state (never a cached verdict) and MUST fail closed.
+     */
+    fun interface Authorizer {
+        fun authorize(context: Context): Decision
+    }
+
+    @Volatile
+    private var authorizer: Authorizer? = null
+
+    /** Instances are held WEAKLY and pruned on every pass: no stale view leaks. */
+    private val views = ArrayList<WeakReference<WebView>>()
+
+    private val main = Handler(Looper.getMainLooper())
+
+    /** Install (or clear) the app's authorizer. Idempotent; any thread. */
+    fun installAuthorizer(next: Authorizer?) {
+        authorizer = next
+        Log.i(TAG, "[WebViewGate] authorizer " + (if (next == null) "cleared" else "installed"))
+    }
+
+    fun hasAuthorizer(): Boolean = authorizer != null
+
+    /**
+     * Ask the app for a FRESH authorization. Fail closed on every doubt:
+     * missing/cleared authorizer, an exception, or a malformed answer.
+     */
+    fun authorize(context: Context): Decision {
+        val current = authorizer ?: return Decision(false, "no-native-authorizer")
+        return try {
+            current.authorize(context)
+        } catch (t: Throwable) {
+            Log.i(TAG, "[WebViewGate] authorizer threw: " + t.message)
+            Decision(false, "authorizer-error")
+        }
+    }
+
+    /** Register a gated view. Duplicate registration is a no-op. */
+    @Synchronized
+    fun register(view: WebView?) {
+        if (view == null) return
+        prune()
+        for (ref in views) {
+            if (ref.get() === view) return
+        }
+        views.add(WeakReference(view))
+        Log.i(TAG, "[WebViewGate] registered live=" + views.size)
+    }
+
+    /** Unregister on drop/destroy. Safe to call twice, from any thread. */
+    @Synchronized
+    fun unregister(view: WebView?) {
+        if (view == null) return
+        val it = views.iterator()
+        while (it.hasNext()) {
+            val live = it.next().get()
+            if (live == null || live === view) it.remove()
+        }
+    }
+
+    @Synchronized
+    private fun prune() {
+        val it = views.iterator()
+        while (it.hasNext()) {
+            if (it.next().get() == null) it.remove()
+        }
+    }
+
+    @Synchronized
+    private fun liveViews(): List<WebView> {
+        prune()
+        val out = ArrayList<WebView>(views.size)
+        for (ref in views) {
+            val live = ref.get()
+            if (live != null) out.add(live)
+        }
+        return out
+    }
+
+    /**
+     * Block EVERY live gated WebView. Callable from any thread (VPN callbacks
+     * arrive on a ConnectivityManager binder thread); the property is applied
+     * on the Android main thread so it can never race a WebView that is being
+     * laid out or destroyed.
+     */
+    fun blockAll(reason: String) {
+        val targets = liveViews()
+        if (Looper.myLooper() == Looper.getMainLooper()) {
+            applyBlock(targets, reason)
+        } else {
+            main.post { applyBlock(targets, reason) }
+        }
+    }
+
+    /**
+     * SERVICE-WORKER COVERAGE (the documented gap in `shouldInterceptRequest`).
+     *
+     * Requests made BY a service worker are NOT delivered to
+     * `WebViewClient.shouldInterceptRequest` — they belong to the page's
+     * service-worker client — so a page-level interstitial cannot see them.
+     * The framework exposes ServiceWorkerController / ServiceWorkerWebSettings
+     * .setBlockNetworkLoads for exactly this (API 24+, i.e. every supported
+     * device). It is a PROCESS-WIDE setting and must be applied before a page
+     * loads, which is why it is set at app start rather than per view.
+     *
+     * The androidx.webkit COMPAT setter is deliberately NOT used: this app's
+     * resolved androidx.webkit build does not expose it (`serviceWorkerWebSettingsCompat`
+     * is unresolved here), and the framework API is present at minSdk 24
+     * anyway. No compat behaviour is claimed.
+     *
+     * FAILURE IS REPORTED, NOT CLAIMED: the return value is true only when the
+     * platform API exists; a swallowed exception is logged and never reported
+     * as coverage.
+     *
+     * @return true only when the platform provides the service-worker setting.
+     */
+    fun blockServiceWorkerNetworkLoads(): Boolean {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.N) {
+            Log.i(TAG, "[ServiceWorker] block UNSUPPORTED (API " + Build.VERSION.SDK_INT + ")")
+            return false
+        }
+        val apply = Runnable {
+            try {
+                ServiceWorkerController.getInstance()
+                    .serviceWorkerWebSettings
+                    .blockNetworkLoads = true
+                Log.i(TAG, "[ServiceWorker] network loads BLOCKED")
+            } catch (t: Throwable) {
+                Log.i(TAG, "[ServiceWorker] block failed: " + t.message)
+            }
+        }
+        if (Looper.myLooper() == Looper.getMainLooper()) apply.run() else main.post(apply)
+        return true
+    }
+
+    private fun applyBlock(targets: List<WebView>, reason: String) {
+        val at = SystemClock.elapsedRealtime()
+        for (view in targets) {
+            try {
+                // 1. No NEW network load may start.
+                view.settings.blockNetworkLoads = true
+                // 2. Stop the load that is in progress (already-dispatched
+                //    requests are residual exposure — see the class note).
+                view.stopLoading()
+                Log.i(TAG, "[WebViewGate] block applied at=" + at + " reason=" + reason)
+            } catch (t: Throwable) {
+                // A destroyed WebView (or a detached one) is not an error: the
+                // React Native teardown is expected to follow.
+                Log.i(TAG, "[WebViewGate] block skipped reason=" + reason + " error=" + t.message)
+            }
+        }
+    }
+}
