# ============================================================
# MedAcademy — Mobile App Environment Variables
# ============================================================
# This file is the complete .env for the MedAcademy project.
# Copy to project root as .env (or .env.local for local overrides).
#
# SECURITY BOUNDARY:
#   EXPO_PUBLIC_* variables are bundled INTO the app binary and
#   are visible to anyone who decompiles the APK/IPA.
#   NEVER put service_role keys or DB passwords here.
#   Server-side secrets → supabase/secrets.template
# ============================================================

# ── Supabase (client-safe — bundled into the app binary) ────
# Supabase Dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xdvjwfuqipatkpimejcb.supabase.co

# Supabase Dashboard → Project Settings → API → anon / public key
# This key is intentionally public — Row Level Security enforces access.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inhkdmp3ZnVxaXBhdGtwaW1lamNiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5NzA2MzQsImV4cCI6MjA5OTU0NjYzNH0.QMTGKiInyYK8kJjrpS39wg7b_gBWhhCbeAUFJJv5neM

# ── App Identity ─────────────────────────────────────────────
# Stable app identifier used for device binding and logging.
# Do NOT change this after first install — it is stored on devices.

# Deep link scheme — matches app.json expo.scheme
EXPO_PUBLIC_APP_SCHEME=medacademy
EXPO_PUBLIC_APP_ID=app-czyg340mpc75
