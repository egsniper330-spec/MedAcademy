# =============================================================================
# MedAcademy — Supabase Backend Required Secrets
# =============================================================================
# FILE: required-secrets.env.example
# Generated: 2026-07-13
# Purpose: All secrets/environment variables required to reproduce the backend.
#
# ⚠️  SECURITY RULES:
#   - NEVER commit real values to version control
#   - Never expose SERVICE_ROLE_KEY or JWT_SECRET to client-side code
#   - SUPABASE_URL and ANON_KEY are safe to include in mobile app builds
#   - All VDOCIPHER, BOOTSTRAP and CRON secrets are server-side only
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE PLATFORM — Auto-injected into Edge Functions by Supabase runtime.
# These do NOT need to be manually set via `supabase secrets set`.
# They are available automatically inside every Edge Function.
# -----------------------------------------------------------------------------
# NOT EXPORTABLE — injected by Supabase at runtime
# Variable: SUPABASE_URL
# Used by: ALL Edge Functions (_shared/auth.ts, verify-play-integrity, video-upload-chunk, etc.)
# Purpose: Project REST API base URL (https://xdvjwfuqipatkpimejcb.supabase.co)
SUPABASE_URL=NOT_EXPORTABLE__INJECTED_BY_SUPABASE_RUNTIME

# NOT EXPORTABLE — injected by Supabase at runtime
# Variable: SUPABASE_SERVICE_ROLE_KEY
# Used by: ALL Edge Functions (admin operations requiring service role)
# Purpose: Bypasses RLS, used for admin/system operations
SUPABASE_SERVICE_ROLE_KEY=NOT_EXPORTABLE__INJECTED_BY_SUPABASE_RUNTIME

# NOT EXPORTABLE — injected by Supabase at runtime
# Variable: SUPABASE_ANON_KEY
# Used by: _shared/auth.ts (anon client), video-upload-chunk
# Purpose: Anonymous/public API key for unauthenticated Supabase calls
SUPABASE_ANON_KEY=NOT_EXPORTABLE__INJECTED_BY_SUPABASE_RUNTIME

# NOTE: Some Edge Functions use SERVICE_ROLE_KEY (without SUPABASE_ prefix).
# This is an alias that must be set manually as a Supabase secret:
#   supabase secrets set SERVICE_ROLE_KEY=<your-service-role-key>
# Used by: admin-enrollment, bootstrap-super-admin, bulk-user-ops,
#          delete-course, delete-lesson, delete-user, get-signed-url,
#          student-operations, trash-cleanup, trash-user
SERVICE_ROLE_KEY=NOT_EXPORTABLE__SET_VIA_SUPABASE_SECRETS

# -----------------------------------------------------------------------------
# VDOCIPHER — Video DRM provider
# Dashboard: https://www.vdocipher.com/dashboard
# Set via: supabase secrets set VDOCIPHER_API_SECRET=<value>
# -----------------------------------------------------------------------------
# NOT EXPORTABLE
# Variable: VDOCIPHER_API_SECRET
# Used by: delete-course, delete-lesson, delete-user, provider-health,
#          vdocipher-debug-creds, vdocipher-delete-video, vdocipher-orphan-cleanup,
#          vdocipher-otp, vdocipher-upload-init, vdocipher-upload-status,
#          video-assemble-upload, video-daily-health, video-health-scan
# Purpose: VdoCipher REST API authentication key for video upload, OTP, deletion
VDOCIPHER_API_SECRET=NOT_EXPORTABLE__SET_VIA_SUPABASE_SECRETS

# NOT EXPORTABLE
# Variable: VDOCIPHER_WEBHOOK_SECRET
# Used by: vdocipher-otp (webhook signature verification)
# Purpose: HMAC secret to verify VdoCipher webhook payloads
VDOCIPHER_WEBHOOK_SECRET=NOT_EXPORTABLE__SET_VIA_SUPABASE_SECRETS

# Optional — defaults to 'https://medacademy.app' in code
# Variable: APP_DOMAIN
# Used by: vdocipher-otp (OTP domain whitelisting)
# Purpose: Allowed domain for VdoCipher OTP playback
APP_DOMAIN=https://medacademy.app

# -----------------------------------------------------------------------------
# BOOTSTRAP — One-time super-admin setup
# Set via: supabase secrets set BOOTSTRAP_SECRET=<random-high-entropy-string>
# -----------------------------------------------------------------------------
# NOT EXPORTABLE
# Variable: BOOTSTRAP_SECRET
# Used by: bootstrap-super-admin
# Purpose: One-time shared secret to authorize initial super-admin creation.
#          Disable/remove after bootstrap is complete.
BOOTSTRAP_SECRET=NOT_EXPORTABLE__SET_VIA_SUPABASE_SECRETS

# -----------------------------------------------------------------------------
# CRON / SCHEDULER
# Set via: supabase secrets set CRON_SECRET=<value>
# -----------------------------------------------------------------------------
# NOT EXPORTABLE
# Variable: CRON_SECRET
# Used by: trash-cleanup (scheduled invocation authentication)
# Purpose: Bearer token to authorize scheduled Edge Function calls (pg_net or cron)
CRON_SECRET=NOT_EXPORTABLE__SET_VIA_SUPABASE_SECRETS

# -----------------------------------------------------------------------------
# GOOGLE PLAY INTEGRITY (Android app attestation)
# Console: https://play.google.com/console → App Integrity
# Set via: supabase secrets set GOOGLE_PLAY_INTEGRITY_DECRYPTION_KEY=<value>
#          supabase secrets set GOOGLE_PLAY_INTEGRITY_VERIFICATION_KEY=<value>
# -----------------------------------------------------------------------------
# NOT EXPORTABLE
# Variable: GOOGLE_PLAY_INTEGRITY_DECRYPTION_KEY
# Used by: verify-play-integrity
# Purpose: AES-256 key to decrypt Play Integrity verdict
GOOGLE_PLAY_INTEGRITY_DECRYPTION_KEY=NOT_EXPORTABLE__SET_VIA_SUPABASE_SECRETS

# NOT EXPORTABLE
# Variable: GOOGLE_PLAY_INTEGRITY_VERIFICATION_KEY
# Used by: verify-play-integrity
# Purpose: Public key to verify Play Integrity verdict signature
GOOGLE_PLAY_INTEGRITY_VERIFICATION_KEY=NOT_EXPORTABLE__SET_VIA_SUPABASE_SECRETS

# -----------------------------------------------------------------------------
# FRONTEND / MOBILE APP (Expo React Native)
# These are client-safe values embedded in the app binary.
# Set in: .env.local or CI/CD environment
# -----------------------------------------------------------------------------
# Safe to expose — used in mobile app build
EXPO_PUBLIC_SUPABASE_URL=https://xdvjwfuqipatkpimejcb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=NOT_EXPORTABLE__ANON_KEY_FROM_SUPABASE_DASHBOARD
EXPO_PUBLIC_APP_ID=medacademy
EXPO_PUBLIC_APP_SCHEME=medacademy

# -----------------------------------------------------------------------------
# SITE / APP URLS (optional overrides)
# -----------------------------------------------------------------------------
# Variable: SITE_URL
# Used by: bulk-user-ops (password reset redirect URL)
# Purpose: Base URL for email redirect links
SITE_URL=https://medacademy.app

# =============================================================================
# SUMMARY OF NON-EXPORTABLE SECRETS (count: 9)
# =============================================================================
# 1. SUPABASE_SERVICE_ROLE_KEY  — Supabase runtime / Supabase dashboard
# 2. SERVICE_ROLE_KEY           — Supabase secrets (alias)
# 3. SUPABASE_ANON_KEY          — Supabase runtime / dashboard
# 4. VDOCIPHER_API_SECRET       — VdoCipher dashboard
# 5. VDOCIPHER_WEBHOOK_SECRET   — VdoCipher dashboard
# 6. BOOTSTRAP_SECRET           — Self-generated random string
# 7. CRON_SECRET                — Self-generated random string
# 8. GOOGLE_PLAY_INTEGRITY_DECRYPTION_KEY  — Google Play Console
# 9. GOOGLE_PLAY_INTEGRITY_VERIFICATION_KEY — Google Play Console
# =============================================================================
