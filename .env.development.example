# ============================================================
# MedAcademy — Development Environment
# ============================================================
# Copy to .env.development.local and fill in your values.
# Uses local Supabase CLI instance by default.
#
# ⚠️  CLIENT-SIDE VARIABLES ONLY — see supabase/secrets.template
#     for server-side secrets (SERVICE_ROLE_KEY, DB_PASSWORD, etc.)
# ============================================================

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stable app identifier — independent from backend provider
EXPO_PUBLIC_APP_ID=medacademy
EXPO_PUBLIC_APP_SCHEME=medacademy
