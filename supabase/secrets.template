# ============================================================
# MedAcademy — Supabase Edge Function Secrets Template
# ============================================================
# These are SERVER-SIDE secrets used exclusively by Edge Functions.
# They are NEVER bundled into the app binary.
#
# HOW TO APPLY:
#   Option A — Supabase CLI (recommended for CI/CD):
#     supabase secrets set --env-file supabase/secrets.template
#
#   Option B — Supabase Dashboard:
#     Project Settings → Edge Functions → Secrets
#     Add each key/value pair manually.
#
# NEVER commit a filled-in copy of this file to version control.
# ============================================================

# ── Supabase Project ─────────────────────────────────────────
# Your Supabase project reference ID
# Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_ID=

# Database password set during project creation
# Dashboard → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase Dashboard → Project Settings → API → anon / public key
SUPABASE_ANON_KEY=

# Supabase Dashboard → Project Settings → API → service_role (secret) key
# ⚠️ NEVER expose this in client-side code or EXPO_PUBLIC_ variables
SUPABASE_SERVICE_ROLE_KEY=
SERVICE_ROLE_KEY=

# ── App Configuration ────────────────────────────────────────
# Your app's public URL or domain (used in auth redirect emails)
SITE_URL=https://medacademy.app
APP_DOMAIN=medacademy.app

# ── VdoCipher (DRM Video Platform) ───────────────────────────
# VdoCipher Dashboard → API Credentials
# Used by Edge Functions to generate OTP tokens for video playback
VDOCIPHER_API_SECRET=

# VdoCipher Dashboard → Webhooks → Secret
# Used to verify incoming webhook signatures
VDOCIPHER_WEBHOOK_SECRET=

# ── Security / Internal ──────────────────────────────────────
# Random secret for the bootstrap-super-admin Edge Function
# Generate with: openssl rand -hex 32
BOOTSTRAP_SECRET=

# Secret for cron-triggered Edge Functions to authenticate
# Generate with: openssl rand -hex 32
CRON_SECRET=
