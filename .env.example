# ============================================================
# MedAcademy — Mobile App Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is excluded by .gitignore.
#
# ⚠️  CLIENT-SIDE VARIABLES ONLY (safe to bundle in the app)
#   Variables prefixed EXPO_PUBLIC_ are embedded in the binary.
#   Server-side secrets → see supabase/secrets.template
# ============================================================

# Supabase Dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase Dashboard → Project Settings → API → anon / public key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stable app identifier — independent from backend provider
# Do NOT use the Supabase project reference here
EXPO_PUBLIC_APP_ID=medacademy

# Deep link scheme (change only if renaming the app)
EXPO_PUBLIC_APP_SCHEME=medacademy
