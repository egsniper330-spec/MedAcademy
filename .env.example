[TEMPLATE]
# ============================================================
# MedAcademy — Mobile/Web App Environment Variables
# ============================================================
# Copy this file to .env.local and set the API base for the target environment.
# NEVER commit .env.local — it is excluded by .gitignore.
#
# EXPO_PUBLIC_* variables are embedded in the app bundle and must not contain
# server-side secrets.
# ============================================================

# Authoritative MedAcademy PHP/MySQL API base.
EXPO_PUBLIC_PHP_API_URL=https://api.medacademy.eu.cc/backend/public/index.php

# Stable app identifier.
EXPO_PUBLIC_APP_ID=medacademy

# Deep link scheme (change only if renaming the app).
EXPO_PUBLIC_APP_SCHEME=medacademy
