{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "vdocipher-rn-bridge": [
        "./src/types/vdocipher-rn-bridge"
      ],
      "expo-modules-core": [
        "./node_modules/expo/node_modules/expo-modules-core"
      ],
      "expo-modules-core/*": [
        "./node_modules/expo/node_modules/expo-modules-core/*"
      ]
    }
  },
  "include": [
    "src",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "babel.config.js",
    "metro.config.js",
    "tailwind.config.js"
  ]
}
