# ─── pnpm hoisting rules ────────────────────────────────────────────────────
#
# Metro's transform worker is a child process that resolves modules from the
# project root via require(). Under pnpm's default isolated linker, only
# packages explicitly listed in the project's own dependencies get a
# root-level node_modules/ symlink — transitive deps don't.
#
# node-linker=hoisted tells pnpm to use a flat node_modules layout (identical
# to npm/yarn behavior). This is the standard setting for Expo/Metro projects
# because Metro's bundler and its child worker processes rely on flat
# node_modules resolution throughout the entire build chain:
#   • babel-preset-expo    — loaded by @babel/core in the transform worker
#   • @babel/core          — Metro's Babel transform engine
#   • @babel/runtime       — Babel helpers required by transpiled code
#   • @expo/metro-config   — Metro config loader used at startup
#   • @expo/cli            — Expo CLI
#   • @expo/config-plugins — loaded by plugins/ at config-eval time
#
# Without hoisted layout, Metro's subprocess require() calls fail with
# "Cannot find module" even for packages that are direct dependencies,
# because the pnpm virtual store path is not on Node's default search path.
# ─────────────────────────────────────────────────────────────────────────────

node-linker=hoisted
